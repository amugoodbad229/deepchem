## IDEA 1: 1D Poisson Solver

**File: `simple_fem_1d.py`**

```python
import torch
import numpy as np

class SimpleFEM1D:
    def __init__(self, n_elements, k=1.0):
        self.n = n_elements
        self.h = 1.0 / n_elements
        self.k = torch.nn.Parameter(torch.tensor(k, dtype=torch.float32))
    
    def assemble(self, f):
        n = self.n - 1
        K = torch.zeros((n, n))
        F = torch.zeros(n)
        ke = self.k / self.h * torch.tensor([[1., -1.], [-1., 1.]])
        for i in range(n):
            K[i, i] += ke[0, 0]
            if i < n - 1:
                K[i, i+1] += ke[0, 1]
                K[i+1, i] += ke[1, 0]
                K[i+1, i+1] += ke[1, 1]
            x_mid = (i + 0.5) * self.h
            F[i] += f(torch.tensor(x_mid)) * self.h
        return K, F
    
    def solve(self, f):
        K, F = self.assemble(f)
        return torch.linalg.solve(K, F)

fem = SimpleFEM1D(n_elements=10, k=2.0)
f = lambda x: torch.sin(np.pi * x)
u = fem.solve(f)
print(f"Solution at midpoint: {u[4]:.4f}")

target = torch.ones(9) * 0.5
optimizer = torch.optim.Adam([fem.k], lr=0.1)

for epoch in range(50):
    optimizer.zero_grad()
    u_pred = fem.solve(f)
    loss = torch.mean((u_pred - target)**2)
    loss.backward()
    optimizer.step()
    if epoch % 10 == 0:
        print(f"Epoch {epoch}: k={fem.k.item():.4f}, loss={loss.item():.6f}")

print(f"Recovered k: {fem.k.item():.4f}")
```

**Run:**
```bash
uv run python simple_fem_1d.py
```

## IDEA 2: Heat Conduction

**File: `heat_conduction.py`**

```python
import torch
import numpy as np

class HeatConduction1D:
    def __init__(self, n_points=20):
        self.x = torch.linspace(0, 1, n_points)
        self.dx = self.x[1] - self.x[0]
        self.conductivity = torch.nn.Parameter(torch.tensor(1.0))
    
    def solve_steady_state(self, T_left, T_right, heat_source):
        n = len(self.x)
        main_diag = torch.ones(n) * 2.0
        off_diag = torch.ones(n-1) * -1.0
        K = (self.conductivity / self.dx**2) * (
            torch.diag(main_diag) + 
            torch.diag(off_diag, 1) + 
            torch.diag(off_diag, -1)
        )
        K[0, :] = 0; K[0, 0] = 1
        K[-1, :] = 0; K[-1, -1] = 1
        F = heat_source(self.x)
        F[0] = T_left
        F[-1] = T_right
        T = torch.linalg.solve(K, F)
        return T

true_k = 3.5
experiment = HeatConduction1D()
experiment.conductivity.data = torch.tensor(true_k)
x = experiment.x
q = torch.sin(np.pi * x)
T_experiment = experiment.solve_steady_state(0.0, 0.0, lambda x: q)
T_measured = T_experiment + 0.01 * torch.randn_like(T_experiment)

model = HeatConduction1D()
model.conductivity.data = torch.tensor(1.0)
optimizer = torch.optim.Adam([model.conductivity], lr=0.5)

for epoch in range(100):
    optimizer.zero_grad()
    T_pred = model.solve_steady_state(0.0, 0.0, lambda x: q)
    loss = torch.mean((T_pred - T_measured)**2)
    loss.backward()
    optimizer.step()
    if epoch % 20 == 0:
        print(f"Epoch {epoch}: k={model.conductivity.item():.4f}, loss={loss.item():.6f}")

print(f"\nRecovered k: {model.conductivity.item():.4f}")
print(f"Error: {abs(model.conductivity.item() - true_k):.4f}")
```

**Run:**
```bash
uv run python heat_conduction.py
```

## IDEA 3: 2D Mesh

**File: `mesh_2d.py`**

```python
import torch
import numpy as np

class SimpleMesh2D:
    def __init__(self, nx=5, ny=5):
        x = torch.linspace(0, 1, nx)
        y = torch.linspace(0, 1, ny)
        xx, yy = torch.meshgrid(x, y, indexing='ij')
        self.nodes = torch.nn.Parameter(torch.stack([xx.flatten(), yy.flatten()], dim=1))
        self.elements = []
        for i in range(nx-1):
            for j in range(ny-1):
                n = i * ny + j
                self.elements.append([n, n+1, n+ny])
                self.elements.append([n+1, n+ny+1, n+ny])
        self.elements = torch.tensor(self.elements)
        self.nx, self.ny = nx, ny
    
    def compute_area(self, element_idx):
        elem = self.elements[element_idx]
        coords = self.nodes[elem]
        v1 = coords[1] - coords[0]
        v2 = coords[2] - coords[0]
        area = 0.5 * torch.abs(v1[0]*v2[1] - v1[1]*v2[0])
        return area
    
    def total_area(self):
        return sum(self.compute_area(i) for i in range(len(self.elements)))

mesh = SimpleMesh2D(nx=4, ny=4)
print(f"Initial total area: {mesh.total_area():.4f}")

optimizer = torch.optim.Adam([mesh.nodes], lr=0.01)

for epoch in range(100):
    optimizer.zero_grad()
    loss = -mesh.total_area()
    loss.backward()
    optimizer.step()
    with torch.no_grad():
        mesh.nodes.data = torch.clamp(mesh.nodes.data, 0, 1)
    if epoch % 20 == 0:
        print(f"Epoch {epoch}: area={mesh.total_area():.4f}")

print(f"\nFinal area: {mesh.total_area():.4f}")
```

**Run:**
```bash
uv run python mesh_2d.py
```

## Validation Scripts

### 1D Poisson Validation

**File: `validate_1d.py`**

```python
import torch
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec

class SimpleFEM1D:
    def __init__(self, n_elements, k=1.0):
        self.n = n_elements
        self.h = 1.0 / n_elements
        self.k = torch.nn.Parameter(torch.tensor(k, dtype=torch.float32))
    
    def assemble(self, f):
        n = self.n - 1
        K = torch.zeros((n, n))
        F = torch.zeros(n)
        ke = self.k / self.h * torch.tensor([[1., -1.], [-1., 1.]])
        for i in range(n):
            K[i, i] += ke[0, 0]
            if i < n - 1:
                K[i, i+1] += ke[0, 1]
                K[i+1, i] += ke[1, 0]
                K[i+1, i+1] += ke[1, 1]
            x_mid = (i + 0.5) * self.h
            F[i] += f(torch.tensor(x_mid)) * self.h
        return K, F
    
    def solve(self, f):
        K, F = self.assemble(f)
        return torch.linalg.solve(K, F)

def analytical_solution(x, k=1.0):
    return torch.sin(np.pi * x) / (np.pi**2 * k)

mesh_sizes = [10, 20, 40, 80, 160]
errors_L2 = []
hs = []

f = lambda x: torch.sin(np.pi * x)

for n in mesh_sizes:
    fem = SimpleFEM1D(n_elements=n, k=1.0)
    u_num = fem.solve(f)
    x = torch.linspace(0, 1, n+1)[1:-1]
    u_exact = analytical_solution(x)
    h = 1.0 / n
    error_L2 = torch.sqrt(torch.mean((u_num - u_exact)**2))
    errors_L2.append(error_L2.item())
    hs.append(h)

rates_L2 = []
for i in range(1, len(errors_L2)):
    rate = np.log(errors_L2[i-1] / errors_L2[i]) / np.log(hs[i-1] / hs[i])
    rates_L2.append(rate)

avg_rate = np.mean(rates_L2)
print(f"Average Convergence Rate: {avg_rate:.4f}")
print(f"Expected Rate: 2.0")
print(f"Test {'PASSED' if abs(avg_rate - 2.0) < 0.2 else 'FAILED'}")

fig = plt.figure(figsize=(14, 10))
gs = GridSpec(2, 2, figure=fig)

ax1 = fig.add_subplot(gs[0, :])
fem = SimpleFEM1D(n_elements=40, k=1.0)
u = fem.solve(f)
x_fine = torch.linspace(0, 1, 200)
x_coarse = torch.linspace(0, 1, 41)[1:-1]
u_exact_fine = analytical_solution(x_fine)
ax1.plot(x_fine.numpy(), u_exact_fine.numpy(), 'k-', linewidth=2, label='Analytical')
ax1.plot(x_coarse.numpy(), u.detach().numpy(), 'ro', markersize=8, label='FEM')
ax1.set_xlabel('x')
ax1.set_ylabel('u(x)')
ax1.legend()
ax1.grid(True, alpha=0.3)

ax2 = fig.add_subplot(gs[1, 0])
hs_array = np.array(hs)
errors_L2_array = np.array(errors_L2)
ax2.loglog(hs_array, errors_L2_array, 'bo-', linewidth=2, markersize=8)
ax2.loglog(hs_array, errors_L2_array[0] * (hs_array / hs_array[0])**2, 'k--', alpha=0.7)
ax2.set_xlabel('Mesh size h')
ax2.set_ylabel('L2 Error')
ax2.grid(True, alpha=0.3, which='both')

ax3 = fig.add_subplot(gs[1, 1])
error_pointwise = torch.abs(u - analytical_solution(x_coarse))
ax3.plot(x_coarse.numpy(), error_pointwise.detach().numpy(), 'g-s', linewidth=2)
ax3.set_xlabel('x')
ax3.set_ylabel('|u_exact - u_num|')
ax3.grid(True, alpha=0.3)

plt.savefig('validation_1d.png', dpi=300, bbox_inches='tight')
print("Figure saved: validation_1d.png")
```

**Run:**
```bash
uv add matplotlib
uv run python validate_1d.py
```

### Heat Conduction Validation

**File: `validate_heat.py`**

```python
import torch
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec

class HeatConduction1D:
    def __init__(self, n_points=20):
        self.x = torch.linspace(0, 1, n_points)
        self.dx = self.x[1] - self.x[0]
        self.conductivity = torch.nn.Parameter(torch.tensor(1.0))
    
    def solve_steady_state(self, T_left, T_right, heat_source):
        n = len(self.x)
        main_diag = torch.ones(n) * 2.0
        off_diag = torch.ones(n-1) * -1.0
        K = (self.conductivity / self.dx**2) * (
            torch.diag(main_diag) + 
            torch.diag(off_diag, 1) + 
            torch.diag(off_diag, -1)
        )
        K[0, :] = 0; K[0, 0] = 1
        K[-1, :] = 0; K[-1, -1] = 1
        F = heat_source(self.x)
        F[0] = T_left
        F[-1] = T_right
        T = torch.linalg.solve(K, F)
        return T

k_true_values = [0.5, 1.0, 2.0, 3.5, 5.0, 10.0]
results = []

for k_true in k_true_values:
    experiment = HeatConduction1D(n_points=50)
    experiment.conductivity.data = torch.tensor(k_true)
    x = experiment.x
    q = torch.sin(np.pi * x)
    T_true = experiment.solve_steady_state(0.0, 0.0, lambda x: q)
    T_measured = T_true + 0.01 * torch.randn_like(T_true) * torch.std(T_true)
    
    model = HeatConduction1D(n_points=50)
    model.conductivity.data = torch.tensor(1.0)
    optimizer = torch.optim.Adam([model.conductivity], lr=0.5)
    
    losses = []
    k_history = []
    
    for epoch in range(200):
        optimizer.zero_grad()
        T_pred = model.solve_steady_state(0.0, 0.0, lambda x: q)
        loss = torch.mean((T_pred - T_measured)**2)
        loss.backward()
        optimizer.step()
        losses.append(loss.item())
        k_history.append(model.conductivity.item())
        if loss.item() < 1e-8:
            break
    
    k_recovered = model.conductivity.item()
    error_pct = abs(k_recovered - k_true) / k_true * 100
    results.append({'k_true': k_true, 'k_recovered': k_recovered, 'error_pct': error_pct, 'k_history': k_history})
    print(f"k_true={k_true:.2f}, k_recovered={k_recovered:.6f}, error={error_pct:.4f}%")

avg_error = np.mean([r['error_pct'] for r in results])
print(f"Average Recovery Error: {avg_error:.4f}%")

fig = plt.figure(figsize=(12, 5))
gs = GridSpec(1, 2, figure=fig)

ax1 = fig.add_subplot(gs[0, 0])
colors = plt.cm.viridis(np.linspace(0, 1, len(results)))
for i, res in enumerate(results):
    ax1.plot(res['k_history'], color=colors[i], linewidth=2)
    ax1.axhline(y=res['k_true'], color=colors[i], linestyle='--', alpha=0.5)
ax1.set_xlabel('Iteration')
ax1.set_ylabel('k')
ax1.grid(True, alpha=0.3)

ax2 = fig.add_subplot(gs[0, 1])
k_trues = [r['k_true'] for r in results]
k_recs = [r['k_recovered'] for r in results]
ax2.plot(k_trues, k_trues, 'k--', linewidth=2)
ax2.scatter(k_trues, k_recs, s=100, c='blue', edgecolors='black')
ax2.set_xlabel('True k')
ax2.set_ylabel('Recovered k')
ax2.grid(True, alpha=0.3)

plt.savefig('validation_heat.png', dpi=300, bbox_inches='tight')
print("Figure saved: validation_heat.png")
```

**Run:**
```bash
uv run python validate_heat.py
```

### Mesh Validation

**File: `validate_mesh.py`**

```python
import torch
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec
from matplotlib.patches import Polygon

class SimpleMesh2D:
    def __init__(self, nx=5, ny=5):
        x = torch.linspace(0, 1, nx)
        y = torch.linspace(0, 1, ny)
        xx, yy = torch.meshgrid(x, y, indexing='ij')
        self.nodes = torch.nn.Parameter(torch.stack([xx.flatten(), yy.flatten()], dim=1))
        self.elements = []
        for i in range(nx-1):
            for j in range(ny-1):
                n = i * ny + j
                self.elements.append([n, n+1, n+ny])
                self.elements.append([n+1, n+ny+1, n+ny])
        self.elements = torch.tensor(self.elements)
        self.nx, self.ny = nx, ny
    
    def compute_area(self, element_idx):
        elem = self.elements[element_idx]
        coords = self.nodes[elem]
        v1 = coords[1] - coords[0]
        v2 = coords[2] - coords[0]
        area = 0.5 * torch.abs(v1[0]*v2[1] - v1[1]*v2[0])
        return area
    
    def total_area(self):
        return sum(self.compute_area(i) for i in range(len(self.elements)))
    
    def compute_aspect_ratio(self, element_idx):
        elem = self.elements[element_idx]
        coords = self.nodes[elem]
        e1 = coords[1] - coords[0]
        e2 = coords[2] - coords[1]
        e3 = coords[0] - coords[2]
        L1_sq = torch.sum(e1**2)
        L2_sq = torch.sum(e2**2)
        L3_sq = torch.sum(e3**2)
        area = self.compute_area(element_idx)
        aspect = 4 * np.sqrt(3) * area / (L1_sq + L2_sq + L3_sq)
        return aspect

mesh_sizes = [(5, 5), (10, 10), (20, 20), (40, 40)]
results = []

for nx, ny in mesh_sizes:
    mesh = SimpleMesh2D(nx=nx, ny=ny)
    total_area = mesh.total_area()
    n_elements = len(mesh.elements)
    aspect_ratios = [mesh.compute_aspect_ratio(i).item() for i in range(n_elements)]
    min_aspect = min(aspect_ratios)
    mean_aspect = np.mean(aspect_ratios)
    results.append({'nx': nx, 'ny': ny, 'area': total_area.item(), 'min_aspect': min_aspect, 'mean_aspect': mean_aspect})
    print(f"{nx}x{ny}: area={total_area:.10f}, min_aspect={min_aspect:.6f}")

print(f"Test {'PASSED' if abs(results[0]['area'] - 1.0) < 1e-6 else 'FAILED'}")

mesh = SimpleMesh2D(nx=6, ny=6)
optimizer = torch.optim.Adam([mesh.nodes], lr=0.01)
quality_history = []

for iter in range(100):
    optimizer.zero_grad()
    aspect_ratios = torch.stack([mesh.compute_aspect_ratio(i) for i in range(len(mesh.elements))])
    min_aspect = torch.min(aspect_ratios)
    loss = -min_aspect
    loss.backward()
    optimizer.step()
    with torch.no_grad():
        mesh.nodes.data = torch.clamp(mesh.nodes.data, 0, 1)
        mesh.nodes.data[0] = torch.tensor([0.0, 0.0])
        mesh.nodes.data[mesh.ny-1] = torch.tensor([0.0, 1.0])
        mesh.nodes.data[(mesh.nx-1)*mesh.ny] = torch.tensor([1.0, 0.0])
        mesh.nodes.data[-1] = torch.tensor([1.0, 1.0])
    quality_history.append(min_aspect.item())

fig = plt.figure(figsize=(12, 10))
gs = GridSpec(2, 2, figure=fig)

ax1 = fig.add_subplot(gs[0, 0])
mesh_initial = SimpleMesh2D(nx=6, ny=6)
nodes = mesh_initial.nodes.detach().numpy()
elements = mesh_initial.elements.numpy()
for elem in elements:
    coords = nodes[elem]
    poly = Polygon(coords, closed=True, edgecolor='black', facecolor='lightblue', alpha=0.5)
    ax1.add_patch(poly)
ax1.plot(nodes[:, 0], nodes[:, 1], 'ko', markersize=4)
ax1.set_xlim(-0.1, 1.1)
ax1.set_ylim(-0.1, 1.1)
ax1.set_aspect('equal')
ax1.set_title('Initial Mesh')
ax1.grid(True, alpha=0.3)

ax2 = fig.add_subplot(gs[0, 1])
nodes_opt = mesh.nodes.detach().numpy()
elements_opt = mesh.elements.numpy()
aspect_ratios = [mesh.compute_aspect_ratio(i).item() for i in range(len(elements_opt))]
for i, elem in enumerate(elements_opt):
    coords = nodes_opt[elem]
    color = plt.cm.RdYlGn(aspect_ratios[i])
    poly = Polygon(coords, closed=True, edgecolor='black', facecolor=color, alpha=0.7)
    ax2.add_patch(poly)
ax2.plot(nodes_opt[:, 0], nodes_opt[:, 1], 'ko', markersize=4)
ax2.set_xlim(-0.1, 1.1)
ax2.set_ylim(-0.1, 1.1)
ax2.set_aspect('equal')
ax2.set_title('Optimized Mesh')
ax2.grid(True, alpha=0.3)

ax3 = fig.add_subplot(gs[1, :])
ax3.plot(quality_history, 'b-', linewidth=2)
ax3.set_xlabel('Iteration')
ax3.set_ylabel('Minimum Aspect Ratio')
ax3.set_title('Optimization Convergence')
ax3.grid(True, alpha=0.3)

plt.savefig('validation_mesh.png', dpi=300, bbox_inches='tight')
print("Figure saved: validation_mesh.png")
```

**Run:**
```bash
uv run python validate_mesh.py
```

