### **2. Include Tests**
```python
# Add a test function
def test_analytical_solution():
    """Test against known solution for -u'' = sin(πx)"""
    fem = SimpleFEM1D(n_elements=20)
    u = fem.solve(lambda x: torch.sin(3.14159*x))
    
    # Exact solution: u(x) = sin(πx)/π²
    x = torch.linspace(0, 1, 21)[1:-1]
    u_exact = torch.sin(3.14159*x) / (3.14159**2)
    
    error = torch.max(torch.abs(u - u_exact))
    assert error < 0.01, f"Error {error} too large!"
    print(f"✓ Test passed! Error: {error:.6f}")

test_analytical_solution()
```

