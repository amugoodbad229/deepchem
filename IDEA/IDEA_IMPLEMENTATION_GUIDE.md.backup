```python
K[0,0] += 3   # K = [[3, 0], [0, 0]]
if 0 < 1:     # True
    K[0,1] += -3   # K = [[3, -3], [0, 0]]
    K[1,0] += -3   # K = [[3, -3], [-3, 0]]
