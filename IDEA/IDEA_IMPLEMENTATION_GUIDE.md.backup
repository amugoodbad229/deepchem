### Research-Grade Validation & Visualization

**Complete geometric validation** (`research_validation_mesh.py`):

```python
"""
Research-Grade Validation for 2D Mesh Data Structure
Includes: Geometric quality metrics, area conservation, shape optimization
"""
import torch
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec
from matplotlib.patches import Polygon
from matplotlib.collections import PatchCollection


class SimpleMesh2D:
    """Core implementation (<50 lines)"""
    def __init__(self, nx=5, ny=5):
        x = torch.linspace(0, 1, nx)
        y = torch.linspace(0, 1, ny)
        xx, yy = torch.meshgrid(x, y, indexing='ij')
        
        self.nodes = torch.nn.Parameter(torch.stack([xx.flatten(), yy.flatten()], dim=1))
        self.elements = []
        
        for i in range(nx-1):
            for j in range(ny-1):
                n = i * ny + j
                self.elements.append([n, n+1, n+ny])
                self.elements.append([n+1, n+ny+1, n+ny])
        
        self.elements = torch.tensor(self.elements)
        self.nx, self.ny = nx, ny
    
    def compute_area(self, element_idx):
        elem = self.elements[element_idx]
        coords = self.nodes[elem]
        
        v1 = coords[1] - coords[0]
        v2 = coords[2] - coords[0]
        area = 0.5 * torch.abs(v1[0]*v2[1] - v1[1]*v2[0])
        return area
    
    def total_area(self):
        return sum(self.compute_area(i) for i in range(len(self.elements)))
    
    def compute_aspect_ratio(self, element_idx):
        """Compute aspect ratio (1.0 = equilateral, 0.0 = degenerate)"""
        elem = self.elements[element_idx]
        coords = self.nodes[elem]
        
        # Edge vectors
        e1 = coords[1] - coords[0]
        e2 = coords[2] - coords[1]
        e3 = coords[0] - coords[2]
        
        # Edge lengths squared
        L1_sq = torch.sum(e1**2)
        L2_sq = torch.sum(e2**2)
        L3_sq = torch.sum(e3**2)
        
        # Area
        area = self.compute_area(element_idx)
        
        # Aspect ratio: 4√3 * Area / (L1² + L2² + L3²)
        aspect = 4 * np.sqrt(3) * area / (L1_sq + L2_sq + L3_sq)
        
        return aspect


def geometric_quality_study():
    """Research-grade study of mesh quality metrics"""
    print("=" * 70)
    print("GEOMETRIC QUALITY STUDY: 2D Mesh Data Structure")
    print("=" * 70)
    
    mesh_sizes = [(5, 5), (10, 10), (20, 20), (40, 40)]
    results = []
    
    print(f"\n{'Mesh Size':<15} {'Elements':<12} {'Total Area':<15} {'Min Aspect':<12}")
    print("-" * 70)
    
    for nx, ny in mesh_sizes:
        mesh = SimpleMesh2D(nx=nx, ny=ny)
        total_area = mesh.total_area()
        n_elements = len(mesh.elements)
        
        # Compute aspect ratios
        aspect_ratios = [mesh.compute_aspect_ratio(i).item() 
                        for i in range(n_elements)]
        
        min_aspect = min(aspect_ratios)
        mean_aspect = np.mean(aspect_ratios)
        
        results.append({
            'nx': nx, 'ny': ny,
            'n_elements': n_elements,
            'area': total_area.item(),
            'min_aspect': min_aspect,
            'mean_aspect': mean_aspect,
            'mesh': mesh
        })
        
        area_error = abs(total_area.item() - 1.0) * 100
        
        print(f"{nx}x{ny}:<15} {n_elements:<12d} {total_area:<15.10f} {min_aspect:<12.6f}")
    
    print("-" * 70)
    print(f"Expected Total Area: 1.0 (Unit Square)")
    print(f"Test {'PASSED ✓' if abs(results[0]['area'] - 1.0) < 1e-6 else 'FAILED ✗'}")
    
    return results


def shape_optimization_demo():
    """Demonstrate differentiable mesh for shape optimization"""
    print("\n" + "=" * 70)
    print("SHAPE OPTIMIZATION: Maximizing Mesh Quality")
    print("=" * 70)
    
    mesh = SimpleMesh2D(nx=6, ny=6)
    optimizer = torch.optim.Adam([mesh.nodes], lr=0.01)
    
    quality_history = []
    area_history = []
    
    print(f"{'Iteration':<12} {'Min Aspect':<15} {'Mean Aspect':<15} {'Area':<12}")
    print("-" * 70)
    
    for iter in range(100):
        optimizer.zero_grad()
        
        # Loss: negative minimum aspect ratio
        aspect_ratios = torch.stack([mesh.compute_aspect_ratio(i) 
                                     for i in range(len(mesh.elements))])
        
        min_aspect = torch.min(aspect_ratios)
        area = mesh.total_area()
        
        loss = -min_aspect + 10.0 * (area - 1.0)**2
        
        loss.backward()
        optimizer.step()
        
        # Project boundary nodes to maintain domain
        with torch.no_grad():
            mesh.nodes.data = torch.clamp(mesh.nodes.data, 0, 1)
            # Keep corners fixed
            mesh.nodes.data[0] = torch.tensor([0.0, 0.0])
            mesh.nodes.data[mesh.ny-1] = torch.tensor([0.0, 1.0])
            mesh.nodes.data[(mesh.nx-1)*mesh.ny] = torch.tensor([1.0, 0.0])
            mesh.nodes.data[-1] = torch.tensor([1.0, 1.0])
        
        quality_history.append(min_aspect.item())
        area_history.append(area.item())
        
        if iter % 20 == 0 or iter == 99:
            mean_aspect = torch.mean(aspect_ratios).item()
            print(f"{iter:<12} {min_aspect.item():<15.6f} {mean_aspect:<15.6f} {area.item():<12.10f}")
    
    print("-" * 70)
    print(f"Quality improvement: {quality_history[0]:.4f} → {quality_history[-1]:.4f}")
    print(f"Area conservation: {area_history[-1]:.10f} (target: 1.0)")
    
    return mesh, quality_history, area_history


def create_publication_plots(results, mesh_opt, quality_history, area_history):
    """Create publication-quality figure with mesh visualizations"""
    fig = plt.figure(figsize=(14, 12))
    gs = GridSpec(3, 2, figure=fig, hspace=0.35, wspace=0.25)
    
    # Plot 1: Initial mesh
    ax1 = fig.add_subplot(gs[0, 0])
    mesh_initial = SimpleMesh2D(nx=6, ny=6)
    nodes = mesh_initial.nodes.detach().numpy()
    elements = mesh_initial.elements.numpy()
    
    for elem in elements:
        coords = nodes[elem]
        poly = Polygon(coords, closed=True, edgecolor='black', 
                      facecolor='lightblue', alpha=0.5)
        ax1.add_patch(poly)
    
    ax1.plot(nodes[:, 0], nodes[:, 1], 'ko', markersize=4)
    ax1.set_xlim(-0.1, 1.1)
    ax1.set_ylim(-0.1, 1.1)
    ax1.set_aspect('equal')
    ax1.set_title('Initial Mesh (Uniform Grid)', fontsize=13, fontweight='bold')
    ax1.grid(True, alpha=0.3)
    
    # Plot 2: Optimized mesh
    ax2 = fig.add_subplot(gs[0, 1])
    nodes_opt = mesh_opt.nodes.detach().numpy()
    elements_opt = mesh_opt.elements.numpy()
    
    aspect_ratios = [mesh_opt.compute_aspect_ratio(i).item() 
                     for i in range(len(elements_opt))]
    
    for i, elem in enumerate(elements_opt):
        coords = nodes_opt[elem]
        color = plt.cm.RdYlGn(aspect_ratios[i])
        poly = Polygon(coords, closed=True, edgecolor='black', 
                      facecolor=color, alpha=0.7)
        ax2.add_patch(poly)
    
    ax2.plot(nodes_opt[:, 0], nodes_opt[:, 1], 'ko', markersize=4)
    ax2.set_xlim(-0.1, 1.1)
    ax2.set_ylim(-0.1, 1.1)
    ax2.set_aspect('equal')
    ax2.set_title('Optimized Mesh (Quality-Based)', fontsize=13, fontweight='bold')
    ax2.grid(True, alpha=0.3)
    
    # Plot 3: Area conservation
    ax3 = fig.add_subplot(gs[1, 0])
    sizes = [r['nx'] for r in results]
    areas = [r['area'] for r in results]
    ax3.semilogy(sizes, [abs(a - 1.0) for a in areas], 'bo-', linewidth=2, markersize=8)
    ax3.axhline(y=1e-6, color='r', linestyle='--', label='Tolerance: 1e-6')
    ax3.set_xlabel('Mesh Size (N×N)', fontsize=12)
    ax3.set_ylabel('|Area - 1.0| (log scale)', fontsize=12)
    ax3.set_title('Area Conservation Test', fontsize=13, fontweight='bold')
    ax3.legend(fontsize=10)
    ax3.grid(True, alpha=0.3, which='both')
    
    # Plot 4: Aspect ratio distribution
    ax4 = fig.add_subplot(gs[1, 1])
    aspects_initial = [mesh_initial.compute_aspect_ratio(i).item() 
                       for i in range(len(mesh_initial.elements))]
    aspects_final = [mesh_opt.compute_aspect_ratio(i).item() 
                     for i in range(len(mesh_opt.elements))]
    
    bins = np.linspace(0, 1, 20)
    ax4.hist(aspects_initial, bins=bins, alpha=0.5, label='Initial', color='blue', edgecolor='black')
    ax4.hist(aspects_final, bins=bins, alpha=0.5, label='Optimized', color='green', edgecolor='black')
    ax4.axvline(x=0.7, color='r', linestyle='--', linewidth=2, label='Good Quality (0.7)')
    ax4.set_xlabel('Aspect Ratio', fontsize=12)
    ax4.set_ylabel('Count', fontsize=12)
    ax4.set_title('Element Quality Distribution', fontsize=13, fontweight='bold')
    ax4.legend(fontsize=10)
    ax4.grid(True, alpha=0.3)
    
    # Plot 5: Quality convergence
    ax5 = fig.add_subplot(gs[2, :])
    iterations = range(len(quality_history))
    ax5.plot(iterations, quality_history, 'b-', linewidth=2, label='Minimum Aspect Ratio')
    ax5.plot(iterations, area_history, 'r--', linewidth=2, label='Total Area')
    ax5.axhline(y=1.0, color='k', linestyle=':', alpha=0.5, label='Target Area (1.0)')
    ax5.set_xlabel('Iteration', fontsize=12)
    ax5.set_ylabel('Value', fontsize=12)
    ax5.set_title('Shape Optimization Convergence', fontsize=14, fontweight='bold')
    ax5.legend(fontsize=10)
    ax5.grid(True, alpha=0.3)
    ax5.set_xlim(0, 100)
    
    plt.savefig('publication_quality_mesh.png', dpi=300, bbox_inches='tight')
    print("\nPublication-quality figure saved: publication_quality_mesh.png")
    
    return fig


if __name__ == "__main__":
    # Run geometric quality study
    results = geometric_quality_study()
    
    # Run shape optimization demo
    mesh_opt, quality_history, area_history = shape_optimization_demo()
    
    # Create publication plots
    fig = create_publication_plots(results, mesh_opt, quality_history, area_history)
    
    print("\n" + "=" * 70)
    print("MESH VALIDATION SUMMARY")
    print("=" * 70)
