## Testing Your Implementation

### Unit Test Example (`test_fem.py`):

```python
import torch
import pytest
from simple_fem_1d import SimpleFEM1D

def test_analytical_solution():
    """Test against known analytical solution"""
    fem = SimpleFEM1D(n_elements=20, k=1.0)
    
    # Source: f(x) = sin(πx)
    # Exact solution: u(x) = sin(πx)/π²
    f = lambda x: torch.sin(3.14159 * x)
    u_num = fem.solve(f)
    
    # Compute exact solution at nodes
    x = torch.linspace(0, 1, 21)[1:-1]
    u_exact = torch.sin(3.14159 * x) / (3.14159**2)
    
    # Check error < 1%
    error = torch.max(torch.abs(u_num - u_exact))
    assert error < 0.01, f"Error {error} too large!"
    print(f"✓ Test passed! Max error: {error:.6f}")

def test_differentiability():
    """Test that gradients flow correctly"""
    fem = SimpleFEM1D(n_elements=10, k=2.0)
    f = lambda x: torch.ones_like(x)
    
    # Forward pass
    u = fem.solve(f)
    loss = torch.sum(u**2)
    
    # Backward pass
    loss.backward()
    
    # Check gradient exists and is non-zero
    assert fem.k.grad is not None, "Gradient not computed!"
    assert fem.k.grad.abs() > 0, "Gradient is zero!"
    print(f"✓ Gradient computed: {fem.k.grad.item():.6f}")

def test_convergence():
    """Test that error decreases with mesh refinement"""
    errors = []
    for n in [10, 20, 40]:
        fem = SimpleFEM1D(n_elements=n, k=1.0)
        f = lambda x: torch.sin(3.14159 * x)
        
        u_num = fem.solve(f)
        x = torch.linspace(0, 1, n+1)[1:-1]
        u_exact = torch.sin(3.14159 * x) / (3.14159**2)
        
        error = torch.mean(torch.abs(u_num - u_exact))
        errors.append(error.item())
    
    # Check error decreases
    assert errors[1] < errors[0], "Error should decrease with refinement"
    assert errors[2] < errors[1], "Error should decrease with refinement"
    print(f"✓ Convergence verified: {errors[0]:.6f} → {errors[1]:.6f} → {errors[2]:.6f}")

if __name__ == "__main__":
    test_analytical_solution()
    test_differentiability()
    test_convergence()
    print("\n✓ All tests passed!")
```

**Run tests:**
```bash
# Run all tests
python test_fem.py

# Or with pytest
pytest test_fem.py -v

# Run specific test
pytest test_fem.py::test_differentiability -v
```

